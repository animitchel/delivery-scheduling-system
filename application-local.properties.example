# Copy to application-local.properties in the repository root.
# Fresh database: activate local,schema-managed; supply DB_PASSWORD in IntelliJ's environment.
# Existing database: follow DATABASE_MIGRATIONS.md before enabling schema-managed.
spring.datasource.url=jdbc:mysql://127.0.0.1:${DB_PORT:3307}/${DB_NAME:scheduling_dev}
spring.datasource.username=${DB_USER:scheduling_app}
spring.datasource.password=${DB_PASSWORD}
spring.jpa.hibernate.ddl-auto=validate
server.port=8080
